{
  "name": "suga-backend",
  "version": "1.0.0",
  "description": "Backend database and API for SUGA, the brownout notifier app",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "db:verify": "node src/db/verify.js",
    "test:api": "node src/api-check.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dotenv": "^18.0.6",
    "express": "^5.3.0"
  }
}
