# Copy this file to .env and fill in the values. Never commit .env.

# Local development: a SQLite file inside backend/data
DATABASE_URL=file:./data/suga.db

# Production (Turso): use your database URL and token instead
# DATABASE_URL=libsql://your-database-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token
DATABASE_AUTH_TOKEN=

# API server
PORT=3000
# Required for admin routes (create/update/delete). Sent as the x-api-key header.
ADMIN_API_KEY=change-me
