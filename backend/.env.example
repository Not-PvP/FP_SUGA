# Copy this file to .env and fill in the values. Never commit .env.

# Local development: a SQLite file inside backend/data
DATABASE_URL=file:./data/suga.db

# Production (Turso): use your database URL and token instead
# DATABASE_URL=libsql://your-database-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token
DATABASE_AUTH_TOKEN=

# API server
PORT=3000

# Admin sign-in. Create an account with: npm run admin:create
# These are only read by that script. Never commit real values.
# ADMIN_EMAIL=admin@suga.ph
# ADMIN_PASSWORD=use-a-long-password
# ADMIN_NAME=SUGA Admin

# How long an admin stays signed in, in hours. Defaults to 12.
ADMIN_SESSION_HOURS=12

# Optional: lets server scripts call admin routes without signing in, using the
# x-api-key header. Leave empty to allow admin access only through sign-in.
ADMIN_API_KEY=

# Browser origins allowed to call the API (Flutter web). * allows any origin.
CORS_ORIGIN=*
